# STM32 项目 .gitignore 文件
# 排除编译生成文件、IDE配置文件和临时文件

# ========================================
# 编译输出目录
# ========================================
build/
Build/
output/
Output/

# ========================================
# CMake 生成文件
# ========================================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
.cmake/

# ========================================
# 编译器输出文件
# ========================================
*.o
*.obj
*.elf
*.bin
*.hex
*.map
*.lst
*.d
*.su
*.size

# ========================================
# ST-Link / J-Link 相关文件
# ========================================
*.stl
*.jlink
*.srec
*.mot

# ========================================
# IDE 和编辑器配置
# ========================================
# Keil MDK
*.uvprojx
*.uvoptx
*.htm
*.dep
*.bak
*.crf
*.lnp
*.axf
*.iex
*.mex

# IAR Embedded Workbench
*.ewp
*.eww
*.ewd
*.pp1
*.pp2
*.pbi
*.pbd
*.dni

# Eclipse / STM32CubeIDE
.project
.cproject
.settings/
.metadata/
.stm32cube/
.launches/

# VS Code
.vscode/
*.code-workspace
.history/

# CLion
.idea/
cmake-build-*/

# ========================================
# 临时文件和日志
# ========================================
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo
*~
.#*

# ========================================
# 操作系统文件
# ========================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.directory

# ========================================
# STM32 特定文件
# ========================================
# STM32CubeMX 生成的项目文件
*.ioc
STM32Cube/

# 启动文件（如果由工具生成）
startup_*.s

# 链接脚本（如果自动生成）
*.ld

# ========================================
# 第三方库和工具
# ========================================
# HAL 库（如果本地包含）
STM32F1xx_HAL_Driver/
CMSIS/

# FreeRTOS（如果本地包含）
FreeRTOS/

# FatFS（如果本地包含）
FatFS/

# ========================================
# 文档生成工具输出
# ========================================
Doxyfile
html/
latex/
rtf/
xml/
man/
doc/

# ========================================
# 调试文件
# ========================================
*.debug
*.dbg
gdbinit

# ========================================
# 备份和旧版本文件
# ========================================
*.orig
*.old
*_backup.*
*_copy.*

# ========================================
# Python 相关（如果使用Python工具）
# ========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# ========================================
# 用户自定义排除规则
# ========================================
# 在此添加你自己的排除规则

# 项目特定的排除规则
.clangd
.settings/
.vscode/
project-description.json
cmake/

# 编译输出目录
build/

# 保留重要的README和文档
!README.md
!readme.md
!*.md

# 保留源代码文件
!*.c
!*.h
!*.cpp
!*.hpp
!*.s
!*.S

# 保留配置文件
!.gitignore
!CMakeLists.txt
